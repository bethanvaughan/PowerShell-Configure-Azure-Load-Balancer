# Interactive Input Function
function Prompt-Input {
    param (
        [string]$Message
    )
    $inputValue = Read-Host "$Message"
    if (-not $inputValue) {
        Write-Host "Input is required for $Message. Please try again." -ForegroundColor Red
        return Prompt-Input -Message $Message
    }
    return $inputValue
}

# Collecting meaningful input from the user
$resourceGroup = Prompt-Input "Enter the Resource Group name"
$location = Prompt-Input "Enter the Azure region (e.g., uksuuth)"
$lbName = Prompt-Input "Enter the Load Balancer name"
$vnetName = Prompt-Input "Enter the Virtual Network name"
$subnetName = Prompt-Input "Enter the Subnet name for the Load Balancer"

Write-Host "Creating Azure Load Balancer with the following configuration:" -ForegroundColor Yellow
Write-Host "Resource Group: $resourceGroup" -ForegroundColor Green
Write-Host "Location: $location" -ForegroundColor Green
Write-Host "Load Balancer Name: $lbName" -ForegroundColor Green
Write-Host "Virtual Network Name: $vnetName" -ForegroundColor Green
Write-Host "Subnet Name: $subnetName" -ForegroundColor Green

if (-not (Read-Host "Proceed with these settings? (yes/no)").ToLower().StartsWith("y")) {
    Write-Host "Script aborted. Please re-run with correct details." -ForegroundColor Red
    return
}

# Create Resource Group if needed
if (-not (Get-AzResourceGroup -Name $resourceGroup -ErrorAction SilentlyContinue)) {
    Write-Host "Creating Resource Group: $resourceGroup" -ForegroundColor Yellow
    New-AzResourceGroup -Name $resourceGroup -Location $location
} else {
    Write-Host "Resource Group $resourceGroup already exists." -ForegroundColor Cyan
}

# Create Virtual Network and Subnet if needed
if (-not (Get-AzVirtualNetwork -Name $vnetName -ResourceGroupName $resourceGroup -ErrorAction SilentlyContinue)) {
    Write-Host "Creating Virtual Network and Subnet" -ForegroundColor Yellow
    New-AzVirtualNetwork -Name $vnetName -ResourceGroupName $resourceGroup -Location $location -AddressPrefix "10.0.0.0/16" |
        Add-AzVirtualNetworkSubnetConfig -Name $subnetName -AddressPrefix "10.0.0.0/24" |
        Set-AzVirtualNetwork
} else {
    Write-Host "Virtual Network $vnetName already exists." -ForegroundColor Cyan
}

# Create Public IP Address
$publicIpName = "$lbName-pip"
if (-not (Get-AzPublicIpAddress -Name $publicIpName -ResourceGroupName $resourceGroup -ErrorAction SilentlyContinue)) {
    Write-Host "Creating Public IP: $publicIpName" -ForegroundColor Yellow
    $publicIp = New-AzPublicIpAddress -Name $publicIpName -ResourceGroupName $resourceGroup -Location $location -AllocationMethod Static -Sku Standard
} else {
    Write-Host "Public IP $publicIpName already exists." -ForegroundColor Cyan
    $publicIp = Get-AzPublicIpAddress -Name $publicIpName -ResourceGroupName $resourceGroup
}

# Create Load Balancer
if (-not (Get-AzLoadBalancer -Name $lbName -ResourceGroupName $resourceGroup -ErrorAction SilentlyContinue)) {
    Write-Host "Creating Load Balancer: $lbName" -ForegroundColor Yellow
    $frontendIp = New-AzLoadBalancerFrontendIpConfig -Name "$lbName-frontend" -PublicIpAddressId $publicIp.Id
    $backendPool = New-AzLoadBalancerBackendAddressPoolConfig -Name "$lbName-backend"
    $probe = New-AzLoadBalancerProbeConfig -Name "HealthProbe" -Protocol Tcp -Port 80 -IntervalInSeconds 15 -ProbeCount 2
    $inboundNatRule = New-AzLoadBalancerInboundNatRuleConfig -Name "NatRule" -FrontendIpConfigurationId $frontendIp.Id -Protocol Tcp -FrontendPort 22 -BackendPort 22
    $loadBalancingRule = New-AzLoadBalancerRuleConfig -Name "LoadBalancingRule" -FrontendIpConfigurationId $frontendIp.Id -BackendAddressPoolId $backendPool.Id -Protocol Tcp -FrontendPort 80 -BackendPort 80 -ProbeId $probe.Id
    
    New-AzLoadBalancer -ResourceGroupName $resourceGroup -Name $lbName -Location $location -Sku Standard -FrontendIpConfiguration $frontendIp -BackendAddressPool $backendPool -Probe $probe -InboundNatRule $inboundNatRule -LoadBalancingRule $loadBalancingRule
} else {
    Write-Host "Load Balancer $lbName already exists." -ForegroundColor Cyan
}

Write-Host "Azure Load Balancer setup completed successfully!" -ForegroundColor Green
